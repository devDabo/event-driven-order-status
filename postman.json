{
  "info": {
    "name": "event-driven-order-status CDC",
    "_postman_id": "f2a4b6e3-8df1-4d12-b4cc-2fe8f6f8d001",
    "description": "Postman collection for the mirrored Debezium CDC order -> payment slice in event-driven-order-status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "connectBaseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "producerBaseUrl",
      "value": "http://localhost:8181"
    },
    {
      "key": "customerId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "price",
      "value": "50.00"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Debezium Connect",
      "item": [
        {
          "name": "List Connectors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{connectBaseUrl}}/connectors",
              "host": [
                "{{connectBaseUrl}}"
              ],
              "path": [
                "connectors"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete order-payment-connector",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{connectBaseUrl}}/connectors/order-payment-connector",
              "host": [
                "{{connectBaseUrl}}"
              ],
              "path": [
                "connectors",
                "order-payment-connector"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create order-payment-connector",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"order-payment-connector\",\n  \"config\": {\n    \"connector.class\": \"io.debezium.connector.postgresql.PostgresConnector\",\n    \"tasks.max\": \"1\",\n    \"database.hostname\": \"host.docker.internal\",\n    \"database.port\": \"5433\",\n    \"database.user\": \"postgres\",\n    \"database.password\": \"admin\",\n    \"database.dbname\": \"postgres\",\n    \"database.server.name\": \"PostgreSQL-15\",\n    \"table.include.list\": \"order.payment_outbox\",\n    \"topic.prefix\": \"debezium\",\n    \"tombstones.on.delete\": \"false\",\n    \"slot.name\": \"order_payment_outbox_slot\",\n    \"plugin.name\": \"pgoutput\",\n    \"auto.create.topics.enable\": false,\n    \"auto.register.schemas\": false\n  }\n}"
            },
            "url": {
              "raw": "{{connectBaseUrl}}/connectors",
              "host": [
                "{{connectBaseUrl}}"
              ],
              "path": [
                "connectors"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get order-payment-connector status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{connectBaseUrl}}/connectors/order-payment-connector/status",
              "host": [
                "{{connectBaseUrl}}"
              ],
              "path": [
                "connectors",
                "order-payment-connector",
                "status"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Producer API",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('orderId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"price\": {{price}}\n}"
            },
            "url": {
              "raw": "{{producerBaseUrl}}/orders",
              "host": [
                "{{producerBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{producerBaseUrl}}/orders/{{orderId}}",
              "host": [
                "{{producerBaseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{producerBaseUrl}}/orders/{{orderId}}/cancel",
              "host": [
                "{{producerBaseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
